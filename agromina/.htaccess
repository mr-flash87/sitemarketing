# AgroMina – configuration Apache / LiteSpeed (Hostinger)
Options -Indexes
DirectoryIndex index.php
AddDefaultCharset UTF-8
ErrorDocument 404 /404.php

<IfModule mod_rewrite.c>
  RewriteEngine On
  # Si le site est dans un sous-dossier (ex. /boutique), remplacez / par /boutique/
  RewriteBase /

  # Forcer HTTPS : retirez les # des deux lignes suivantes une fois le SSL activé dans hPanel
  # RewriteCond %{HTTPS} off
  # RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # Fiche produit : /produit/thiakry-mil
  RewriteRule ^produit/([A-Za-z0-9-]+)/?$ produit.php?slug=$1 [L,QSA]

  # /admin -> /admin/
  RewriteRule ^admin$ admin/ [L,R=301]

  # Adresses sans .php : /boutique -> boutique.php
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_FILENAME}.php -f
  RewriteRule ^(.+?)/?$ $1.php [L]
</IfModule>

# Fichiers internes jamais servis directement
<FilesMatch "(^\.|\.(sql|md|lock|log)$|^_layout\.php$)">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/jpeg "access plus 1 month"
  ExpiresByType image/png "access plus 1 month"
  ExpiresByType image/webp "access plus 1 month"
  ExpiresByType text/css "access plus 1 week"
  ExpiresByType application/javascript "access plus 1 week"
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml
</IfModule>
